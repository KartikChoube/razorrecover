# RazorRecover Environment Configuration
# Copy this file to .env and fill in your values.

# Database (PostgreSQL via Supabase or local Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/razorrecover

# Redis (Upstash or local Docker)
REDIS_URL=redis://localhost:6379/0

# Groq API (free tier: https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Razorpay (test mode: https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your-key-here
RAZORPAY_KEY_SECRET=your-secret-here

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
